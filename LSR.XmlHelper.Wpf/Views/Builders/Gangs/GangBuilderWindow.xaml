                                                                    <DataTrigger Binding="{Binding Name}" Value="IsAnimal">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource BooleanDispatchableFieldEditorTemplate}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="OverrideHelmet">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource BooleanDispatchableFieldEditorTemplate}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="ShrinkHeadForMask">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource BooleanDispatchableFieldEditorTemplate}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="IsInvisibleAndInvulnerable">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource BooleanDispatchableFieldEditorTemplate}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ContentControl Content="{Binding}">
                                                        <ContentControl.Style>
                                                            <Style TargetType="ContentControl">
                                                                <Setter Property="ContentTemplate" Value="{StaticResource DefaultDispatchableFieldEditorTemplate}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Name}" Value="CombatRange">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource CombatRangeDispatchableFieldEditorTemplate}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="CombatMovement">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource CombatMovementDispatchableFieldEditorTemplate}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="CombatAbilityMin">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource CombatAbilityDispatchableFieldEditorTemplate}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="CombatAbilityMax">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource CombatAbilityDispatchableFieldEditorTemplate}" />
                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding Name}" Value="AllowRandomizeBeforeVariationApplied">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource BooleanDispatchableFieldEditorTemplate}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="RandomizeHead">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource BooleanDispatchableFieldEditorTemplate}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="OverrideAgencyLessLethalWeapons">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource BooleanDispatchableFieldEditorTemplate}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="OverrideAgencySideArms">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource BooleanDispatchableFieldEditorTemplate}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="OverrideAgencyLongGuns">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource BooleanDispatchableFieldEditorTemplate}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="DisableWrithe">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource BooleanDispatchableFieldEditorTemplate}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="DisableWritheShooting">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource BooleanDispatchableFieldEditorTemplate}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="DisableCriticalHits">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource BooleanDispatchableFieldEditorTemplate}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="DisableBulletRagdoll">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource BooleanDispatchableFieldEditorTemplate}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="HasFullBodyArmor">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource BooleanDispatchableFieldEditorTemplate}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="AlwaysHasLongGun">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource BooleanDispatchableFieldEditorTemplate}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="IsAnimal">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource BooleanDispatchableFieldEditorTemplate}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="OverrideHelmet">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource BooleanDispatchableFieldEditorTemplate}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="ShrinkHeadForMask">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource BooleanDispatchableFieldEditorTemplate}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="IsInvisibleAndInvulnerable">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource BooleanDispatchableFieldEditorTemplate}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock
                                    Margin="0,10,0,6"
                                    FontSize="14"
                                    Text="Selected field editor" />

                                <TextBlock Margin="0,0,0,4" Text="{Binding SelectedDispatchablePersonField.Name}" />

                                <TextBlock
                                    Margin="0,0,0,6"
                                    Text="{Binding SelectedDispatchablePersonField.TooltipText}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Left"
                                    Command="{Binding SmartPasteRequiredVariationCommand}"
                                    Content="Smart paste RequiredVariation"
                                    ToolTip="Pastes RequiredVariation, PedVariation, or SavedOutfit XML from the clipboard. If you paste PedVariation or SavedOutfit, it converts it into RequiredVariation automatically."
                                    Visibility="{Binding ShowSmartPasteRequiredVariation, Converter={StaticResource BoolToVis}}" />
                                <TextBox
                                    Height="120"
                                    AcceptsReturn="True"
                                    HorizontalScrollBarVisibility="Auto"
                                    Text="{Binding SelectedDispatchablePersonField.Value, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IncludeDens, Converter={StaticResource BoolToVis}}">
                        <TextBlock
                            Margin="0,10,0,6"
                            FontSize="16"
                            Text="Den options" />
                        <CheckBox
                            Margin="0,0,0,6"
                            IsChecked="{Binding CreateNewDen}"
                            IsEnabled="{Binding IncludeDens}">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Content" Value="Create new den (instead of cloning)" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditExistingGang}" Value="True">
                                            <Setter Property="Content" Value="Edit gang den" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                        <StackPanel
                            Margin="0,0,0,6"
                            IsEnabled="{Binding IncludeDens}"
                            Visibility="{Binding CreateNewDen, Converter={StaticResource InverseBoolToVis}}">
                            <CheckBox Content="Keep cloned den TypeName from source gang" IsChecked="{Binding KeepSourceDenTypeName}" />
                        </StackPanel>
                        <StackPanel
                            Margin="0,0,0,6"
                            IsEnabled="{Binding IncludeDens}"
                            Visibility="{Binding CreateNewDen, Converter={StaticResource BoolToVis}}">
