                                SelectedValuePath="Id"
                                TextSearch.TextPath="DisplayText" />
                            <Border
                                Margin="0,8,0,6"
                                Padding="8"
                                Background="{Binding Appearance.GangBuilderWindowControlBackgroundBrush}"
                                BorderBrush="{Binding Appearance.GangBuilderWindowControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{Binding TerritoryCurrentSetupHasData, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    FontFamily="Consolas"
                                    Text="{Binding TerritoryCurrentSetupText}"
                                    TextWrapping="Wrap" />
                            </Border>
                            <CheckBox Content="Clone territory menus into pack (merges into ShopMenus+_PackName.xml)" IsChecked="{Binding CloneTerritoryMenusIntoPack}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IncludeDealerMenus, Converter={StaticResource BoolToVis}}">
                        <TextBlock
                            Margin="0,10,0,6"
                            FontSize="16"
                            Text="Dealer menu group" />
                        <CheckBox
                            Margin="0,0,0,6"
                            Content="Use source gang dealer menu group"
                            IsChecked="{Binding UseSourceGangDealerMenuGroup}"
                            IsEnabled="{Binding IncludeDealerMenus}"
                            Visibility="{Binding IsEditExistingGang, Converter={StaticResource InverseBoolToVis}}" />
                        <CheckBox
                            Margin="0,0,0,6"
                            Content="Show customer menus"
                            IsChecked="{Binding ShowCustomerMenus}"
                            IsEnabled="{Binding IncludeDealerMenus}" />
                        <CheckBox
                            Margin="0,0,0,6"
                            Content="Clone dealer menus into pack (creates ShopMenus+_PackName.xml)"
                            IsChecked="{Binding CloneDealerMenusIntoPack}"
                            IsEnabled="{Binding IncludeDealerMenus}"
                            Visibility="{Binding IsEditExistingGang, Converter={StaticResource InverseBoolToVis}}" />
                        <StackPanel IsEnabled="{Binding IncludeDealerMenus}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UseSourceGangDealerMenuGroup}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <DockPanel Margin="0,0,0,8" LastChildFill="True">
                                <Button
                                    Width="110"
                                    Margin="0,0,8,0"
                                    Command="{Binding RefreshShopMenuGroupsCommand}"
                                    Content="Refresh" />
                                <ComboBox
                                    MinWidth="420"
                                    DisplayMemberPath="DisplayText"
                                    IsEditable="False"
                                    IsTextSearchEnabled="True"
                                    ItemsSource="{Binding ShopMenuGroups}"
                                    SelectedItem="{Binding SelectedShopMenuGroup}" />
                            </DockPanel>
                            <TextBox
                                x:Name="ManualDealerMenuGroupTextBox"
                                Margin="0,0,0,6"
                                Text="{Binding ManualDealerMenuGroupId, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IncludeWeapons, Converter={StaticResource BoolToVis}}">
                        <TextBlock
                            Margin="0,10,0,6"
                            FontSize="16"
                            Text="Weapons loadouts" />
                        <CheckBox
                            Margin="0,0,0,4"
                            Content="Use source gang weapon loadouts"
                            IsChecked="{Binding UseSourceGangWeaponsLoadouts}"
                            IsEnabled="{Binding IncludeWeapons}"
                            Visibility="{Binding IsEditExistingGang, Converter={StaticResource InverseBoolToVis}}" />
                        <CheckBox
                            Margin="0,0,0,8"
                            Content="Clone weapons into pack (creates IssuableWeapons+_PackName.xml)"
                            IsChecked="{Binding CloneWeaponsIntoPack}"
                            Visibility="{Binding IsEditExistingGang, Converter={StaticResource InverseBoolToVis}}">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="IsEnabled" Value="{Binding IncludeWeapons}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UseSourceGangWeaponsLoadouts}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                        <TextBlock
                            Margin="0,0,0,2"
                            IsEnabled="{Binding IncludeWeapons}"
                            Opacity="0.85"
                            Text="{Binding SourceMeleeWeaponsId, StringFormat=Source melee: {0}}" />
                        <TextBlock
                            Margin="0,0,0,2"
                            IsEnabled="{Binding IncludeWeapons}"
                            Opacity="0.85"
                            Text="{Binding SourceSideArmsId, StringFormat=Source sidearms: {0}}" />
                        <TextBlock
                            Margin="0,0,0,8"
                            IsEnabled="{Binding IncludeWeapons}"
                            Opacity="0.85"
                            Text="{Binding SourceLongGunsId, StringFormat=Source long guns: {0}}" />
                        <StackPanel IsEnabled="{Binding IncludeWeapons}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UseSourceGangWeaponsLoadouts}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <DockPanel Margin="0,0,0,6" LastChildFill="True">
                                <Button
                                    Width="110"
                                    Margin="0,0,8,0"
                                    Command="{Binding RefreshIssuableWeaponsGroupsCommand}"
                                    Content="Refresh" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Opacity="0.85"
                                    Text="Pick from IssuableWeapons groups" />
                            </DockPanel>
                            <TextBlock Text="Melee Weapons ID" />
                            <ComboBox
                                Margin="0,6,0,8"
                                DisplayMemberPath="DisplayText"
                                IsEditable="False"
                                IsTextSearchEnabled="True"
                                ItemsSource="{Binding MeleeWeaponsGroups}"
                                SelectedItem="{Binding SelectedMeleeWeaponsGroup}" />
                            <TextBox Margin="0,0,0,10" Text="{Binding MeleeWeaponsId, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Sidearms ID" />
                            <ComboBox
                                Margin="0,6,0,8"
                                DisplayMemberPath="DisplayText"
                                IsEditable="False"
                                IsTextSearchEnabled="True"
                                ItemsSource="{Binding SidearmWeaponsGroups}"
                                SelectedItem="{Binding SelectedSideArmsGroup}" />
                            <TextBox Margin="0,0,0,10" Text="{Binding SideArmsId, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Long Guns ID" />
                            <ComboBox
                                Margin="0,6,0,8"
                                DisplayMemberPath="DisplayText"
                                IsEditable="False"
                                IsTextSearchEnabled="True"
                                ItemsSource="{Binding LongGunWeaponsGroups}"
                                SelectedItem="{Binding SelectedLongGunsGroup}" />
                            <TextBox Margin="0,0,0,6" Text="{Binding LongGunsId, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IncludeRelationships, Converter={StaticResource BoolToVis}}">
                        <TextBlock
                            Margin="0,10,0,6"
                            FontSize="16"
                            Text="Relationships" />
                        <CheckBox
                            Margin="0,0,0,4"
                            Content="Use source gang enemies"
                            IsChecked="{Binding UseSourceGangEnemyGangs}"
                            IsEnabled="{Binding IncludeRelationships}"
                            Visibility="{Binding IsEditExistingGang, Converter={StaticResource InverseBoolToVis}}" />
                        <TextBlock
                            Margin="0,0,0,8"
                            IsEnabled="{Binding IncludeRelationships}"
                            Opacity="0.85"
                            Text="{Binding SourceEnemyGangsSummary, StringFormat=Source enemies: {0}}" />
                        <TextBlock
                            Margin="0,0,0,4"
                            IsEnabled="{Binding IncludeRelationships}"
                            Text="Enemy gangs (multi-select)" />
                        <ListBox
                            Height="160"
                            infra:ListBoxSelectedItemsBehavior.Enable="True"
                            infra:ListBoxSelectedItemsBehavior.SelectedItems="{Binding SelectedEnemyGangs}"
                            IsEnabled="{Binding IncludeRelationships}"
                            ItemsSource="{Binding ExistingGangs}"
                            SelectionMode="Multiple">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="Background" Value="{Binding Appearance.GangBuilderWindowControlBackgroundBrush}" />
                                    <Setter Property="BorderBrush" Value="{Binding Appearance.GangBuilderWindowControlBorderBrush}" />
                                    <Setter Property="Foreground" Value="{Binding Appearance.GangBuilderWindowTextBrush}" />
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UseSourceGangEnemyGangs}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayText}" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Expander
                            Margin="0,10,0,0"
                            Header="Advanced gang settings"
                            IsExpanded="False">
                            <Border
                                Margin="0,6,0,0"
                                Padding="8"
                                Background="{Binding Appearance.GangBuilderWindowControlBackgroundBrush}"
                                BorderBrush="{Binding Appearance.GangBuilderWindowControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel>
                                    <Expander Header="Reputation levels" IsExpanded="False">
                                        <UniformGrid Margin="0,6,0,8" Columns="4">
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="MinimumRep" />
                                                <TextBox Width="140" Text="{Binding MinimumRep, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="MaximumRep" />
                                                <TextBox Width="140" Text="{Binding MaximumRep, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="StartingRep" />
                                                <TextBox Width="140" Text="{Binding StartingRep, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="HostileRepLevel" />
                                                <TextBox Width="140" Text="{Binding HostileRepLevel, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="NeutralRepLevel" />
                                                <TextBox Width="140" Text="{Binding NeutralRepLevel, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="FriendlyRepLevel" />
                                                <TextBox Width="140" Text="{Binding FriendlyRepLevel, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="MemberOfferRepLevel" />
                                                <TextBox Width="140" Text="{Binding MemberOfferRepLevel, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="HitSquadRep" />
                                                <TextBox Width="140" Text="{Binding HitSquadRep, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </Expander>

                                    <Expander Header="Job payments (min/max)" IsExpanded="False">
                                        <UniformGrid Margin="0,6,0,8" Columns="4">
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="PickupPaymentMin" />
                                                <TextBox Width="140" Text="{Binding PickupPaymentMin, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="PickupPaymentMax" />
                                                <TextBox Width="140" Text="{Binding PickupPaymentMax, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="TheftPaymentMin" />
                                                <TextBox Width="140" Text="{Binding TheftPaymentMin, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="TheftPaymentMax" />
                                                <TextBox Width="140" Text="{Binding TheftPaymentMax, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="HitPaymentMin" />
                                                <TextBox Width="140" Text="{Binding HitPaymentMin, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="HitPaymentMax" />
                                                <TextBox Width="140" Text="{Binding HitPaymentMax, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="DeliveryPaymentMin" />
                                                <TextBox Width="140" Text="{Binding DeliveryPaymentMin, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="DeliveryPaymentMax" />
                                                <TextBox Width="140" Text="{Binding DeliveryPaymentMax, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="WheelmanPaymentMin" />
                                                <TextBox Width="140" Text="{Binding WheelmanPaymentMin, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="WheelmanPaymentMax" />
                                                <TextBox Width="140" Text="{Binding WheelmanPaymentMax, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="ImpoundTheftPaymentMin" />
                                                <TextBox Width="140" Text="{Binding ImpoundTheftPaymentMin, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="ImpoundTheftPaymentMax" />
                                                <TextBox Width="140" Text="{Binding ImpoundTheftPaymentMax, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="BodyDisposalPaymentMin" />
                                                <TextBox Width="140" Text="{Binding BodyDisposalPaymentMin, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="BodyDisposalPaymentMax" />
                                                <TextBox Width="140" Text="{Binding BodyDisposalPaymentMax, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="CopHitPaymentMin" />
                                                <TextBox Width="140" Text="{Binding CopHitPaymentMin, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="CopHitPaymentMax" />
                                                <TextBox Width="140" Text="{Binding CopHitPaymentMax, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="AmbushPaymentMin" />
                                                <TextBox Width="140" Text="{Binding AmbushPaymentMin, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="AmbushPaymentMax" />
                                                <TextBox Width="140" Text="{Binding AmbushPaymentMax, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="BriberyPaymentMin" />
                                                <TextBox Width="140" Text="{Binding BriberyPaymentMin, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="BriberyPaymentMax" />
                                                <TextBox Width="140" Text="{Binding BriberyPaymentMax, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="ArsonPaymentMin" />
                                                <TextBox Width="140" Text="{Binding ArsonPaymentMin, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="ArsonPaymentMax" />
                                                <TextBox Width="140" Text="{Binding ArsonPaymentMax, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </Expander>

                                    <Expander Header="Behaviour &amp; equipment percentages" IsExpanded="False">
                                        <UniformGrid Margin="0,6,0,8" Columns="4">
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="FightPercentage" />
                                                <TextBox Width="140" Text="{Binding FightPercentage, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="FightPolicePercentage" />
                                                <TextBox Width="140" Text="{Binding FightPolicePercentage, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="AlwaysFightPolicePercentage" />
                                                <TextBox Width="140" Text="{Binding AlwaysFightPolicePercentage, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="DrugDealerPercentage" />
                                                <TextBox Width="140" Text="{Binding DrugDealerPercentage, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="PercentageTrustingOfPlayer" />
                                                <TextBox Width="140" Text="{Binding PercentageTrustingOfPlayer, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="PercentageWithLongGuns" />
                                                <TextBox Width="140" Text="{Binding PercentageWithLongGuns, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="PercentageWithSidearms" />
                                                <TextBox Width="140" Text="{Binding PercentageWithSidearms, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="PercentageWithMelee" />
                                                <TextBox Width="140" Text="{Binding PercentageWithMelee, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="VehicleSpawnPercentage" />
                                                <TextBox Width="140" Text="{Binding VehicleSpawnPercentage, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="PedestrianSpawnPercentageAroundDen" />
                                                <TextBox Width="140" Text="{Binding PedestrianSpawnPercentageAroundDen, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </Expander>

                                    <Expander Header="Member money &amp; kick-up" IsExpanded="False">
                                        <UniformGrid Margin="0,6,0,8" Columns="4">
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="AmbientMemberMoneyMin" />
                                                <TextBox Width="140" Text="{Binding AmbientMemberMoneyMin, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="AmbientMemberMoneyMax" />
                                                <TextBox Width="140" Text="{Binding AmbientMemberMoneyMax, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="DealerMemberMoneyMin" />
                                                <TextBox Width="140" Text="{Binding DealerMemberMoneyMin, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="DealerMemberMoneyMax" />
                                                <TextBox Width="140" Text="{Binding DealerMemberMoneyMax, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="CostToPayoffGangScalar" />
                                                <TextBox Width="140" Text="{Binding CostToPayoffGangScalar, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="MemberKickUpDays" />
                                                <TextBox Width="140" Text="{Binding MemberKickUpDays, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="MemberKickUpAmount" />
                                                <TextBox Width="140" Text="{Binding MemberKickUpAmount, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10">
                                                <TextBlock Text="MemberKickUpMissLimit" />
                                                <TextBox Width="140" Text="{Binding MemberKickUpMissLimit, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </Expander>

                                    <Expander Header="Loan parameters" IsExpanded="True">
                                        <DataGrid
                                            MinHeight="140"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            HeadersVisibility="Column"
                                            ItemsSource="{Binding LoanParameters}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn
                                                    Width="*"
                                                    Binding="{Binding ResepectLevel, UpdateSourceTrigger=PropertyChanged}"
                                                    Header="ResepectLevel" />
                                                <DataGridTextColumn
                                                    Width="*"
                                                    Binding="{Binding Rate, UpdateSourceTrigger=PropertyChanged}"
                                                    Header="Rate" />
                                                <DataGridTextColumn
                                                    Width="*"
                                                    Binding="{Binding MaxPeriods, UpdateSourceTrigger=PropertyChanged}"
                                                    Header="MaxPeriods" />
                                                <DataGridTextColumn
                                                    Width="*"
                                                    Binding="{Binding MinAmount, UpdateSourceTrigger=PropertyChanged}"
                                                    Header="MinAmount" />
                                                <DataGridTextColumn
                                                    Width="*"
                                                    Binding="{Binding MaxAmount, UpdateSourceTrigger=PropertyChanged}"
                                                    Header="MaxAmount" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </Expander>
                        <StackPanel Margin="0,10,0,0">
                            <Button
                                Height="38"
                                Command="{Binding BuildPackCommand}"
                                Content="Build (F5)" />
                        </StackPanel>
                        <Border
                            Margin="0,12,0,0"
                            Padding="10"
                            Background="{Binding Appearance.GangBuilderWindowControlBackgroundBrush}"
                            BorderBrush="{Binding Appearance.GangBuilderWindowControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasBuildSummary, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="16"
                                    Text="Build summary" />
                                <TextBlock
                                    Margin="0,0,0,10"
                                    Text="{Binding BuildSummaryText}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,0,0,6"
                                    FontSize="14"
                                    Text="Files" />
                                <ItemsControl ItemsSource="{Binding BuildOutputFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,6">
                                                <Button
                                                    Width="70"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding DataContext.OpenBuildOutputFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding FullPath}"
                                                    Content="Open"
                                                    DockPanel.Dock="Right" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="{Binding FileName}"
                                                    TextWrapping="Wrap" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
