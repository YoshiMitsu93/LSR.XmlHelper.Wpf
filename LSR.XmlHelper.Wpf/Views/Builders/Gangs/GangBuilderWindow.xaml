                                                <DataTrigger Binding="{Binding IsEditExistingGang}" Value="True">
                                                    <Setter Property="Content" Value="Edit den inventory" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
