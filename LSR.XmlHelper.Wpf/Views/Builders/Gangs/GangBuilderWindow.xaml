                                            Width="70"
                                            Binding="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged}"
                                            Header="Buy" />
                                        <DataGridTextColumn
                                            Width="70"
                                            Binding="{Binding SalesPrice, UpdateSourceTrigger=PropertyChanged}"
                                            Header="Sell" />
