                                IsEditable="False"
                                IsTextSearchEnabled="True"
                                ItemsSource="{Binding ShopMenusForSelectedGroup}"
                                SelectedItem="{Binding SelectedDenShopMenu}" />
                            <Border Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditExistingGang}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
