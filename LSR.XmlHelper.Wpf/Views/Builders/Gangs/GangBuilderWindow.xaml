<Window
    x:Class="LSR.XmlHelper.Wpf.Views.Builders.GangBuilderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="clr-namespace:LSR.XmlHelper.Wpf.Infrastructure"
    x:Name="GangBuilderRoot"
    Title="Gang Builder"
    Width="1200"
    Height="800"
    Background="{Binding Appearance.GangBuilderWindowBackgroundBrush}"
    FontFamily="{Binding Appearance.UiFontFamily}"
    FontSize="{Binding Appearance.UiFontSize}"
    FontStyle="{Binding Appearance.UiFontStyle}"
    FontWeight="{Binding Appearance.UiFontWeight}"
    Foreground="{Binding Appearance.GangBuilderWindowTextBrush}"
    Icon="/Assets/AppIcon.ico"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding BuildPackCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{Binding DataContext.Appearance.GangBuilderWindowControlBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="BorderBrush" Value="{Binding DataContext.Appearance.GangBuilderWindowControlBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Foreground" Value="{Binding DataContext.Appearance.GangBuilderWindowTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="{Binding DataContext.Appearance.GangBuilderWindowControlBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="BorderBrush" Value="{Binding DataContext.Appearance.GangBuilderWindowControlBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Foreground" Value="{Binding DataContext.Appearance.GangBuilderWindowTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton
                                x:Name="ToggleButton"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                ClickMode="Press"
                                Focusable="False"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox
                                        x:Name="PART_EditableTextBox"
                                        Grid.Column="0"
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{TemplateBinding Foreground}"
                                        Text="{TemplateBinding Text}"
                                        Visibility="Collapsed" />
                                    <ContentPresenter
                                        x:Name="ContentSite"
                                        Grid.Column="0"
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                        TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <Path
                                        Grid.Column="1"
                                        Width="10"
                                        Height="6"
                                        Margin="8,0,8,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Data="M 0 0 L 10 0 L 5 6 Z"
                                        Fill="{TemplateBinding Foreground}" />
                                </Grid>
                            </ToggleButton>

                            <Popup
                                x:Name="Popup"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PopupAnimation="Fade">
                                <Border
                                    Background="{Binding DataContext.Appearance.GangBuilderWindowControlBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                    BorderBrush="{Binding DataContext.Appearance.GangBuilderWindowControlBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                    BorderThickness="1">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="{Binding DataContext.Appearance.GangBuilderWindowControlBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Foreground" Value="{Binding DataContext.Appearance.GangBuilderWindowTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{Binding DataContext.Appearance.GangBuilderWindowButtonHoverBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="{Binding DataContext.Appearance.GangBuilderWindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="BorderBrush" Value="{Binding DataContext.Appearance.GangBuilderWindowControlBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{Binding DataContext.Appearance.GangBuilderWindowTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Background" Value="{Binding DataContext.Appearance.GangBuilderWindowControlBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="BorderBrush" Value="{Binding DataContext.Appearance.GangBuilderWindowControlBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border
                            x:Name="TabBorder"
                            Margin="0,0,2,0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{Binding DataContext.Appearance.GangBuilderWindowHeaderBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Setter Property="Foreground" Value="{Binding DataContext.Appearance.GangBuilderWindowHeaderTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{Binding DataContext.Appearance.GangBuilderWindowButtonHoverBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="{Binding DataContext.Appearance.GangBuilderWindowControlBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Foreground" Value="{Binding DataContext.Appearance.GangBuilderWindowTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="BorderBrush" Value="{Binding DataContext.Appearance.GangBuilderWindowControlBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{Binding DataContext.Appearance.GangBuilderWindowHeaderBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Foreground" Value="{Binding DataContext.Appearance.GangBuilderWindowHeaderTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="BorderBrush" Value="{Binding DataContext.Appearance.GangBuilderWindowControlBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Foreground" Value="{Binding DataContext.Appearance.GangBuilderWindowTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Background" Value="{Binding DataContext.Appearance.GangBuilderWindowControlBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="BorderBrush" Value="{Binding DataContext.Appearance.GangBuilderWindowControlBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="6,3" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{Binding DataContext.Appearance.GangBuilderWindowGridRowSelectedBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Background" Value="{Binding DataContext.Appearance.GangBuilderWindowButtonBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Foreground" Value="{Binding DataContext.Appearance.GangBuilderWindowButtonTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="BorderBrush" Value="{Binding DataContext.Appearance.GangBuilderWindowControlBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{Binding DataContext.Appearance.GangBuilderWindowButtonHoverBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{Binding DataContext.Appearance.GangBuilderWindowButtonHoverBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="{Binding DataContext.Appearance.GangBuilderWindowControlBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="BorderBrush" Value="{Binding DataContext.Appearance.GangBuilderWindowControlBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Foreground" Value="{Binding DataContext.Appearance.GangBuilderWindowTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding DataContext.Appearance.GangBuilderWindowTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Padding" Value="4,2" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding DataContext.Appearance.GangBuilderWindowButtonHoverBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{Binding DataContext.Appearance.GangBuilderWindowGridRowSelectedBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Setter Property="Foreground" Value="{Binding DataContext.Appearance.GangBuilderWindowButtonTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="{Binding DataContext.Appearance.GangBuilderWindowControlBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Foreground" Value="{Binding DataContext.Appearance.GangBuilderWindowTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding DataContext.Appearance.GangBuilderWindowButtonHoverBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{Binding DataContext.Appearance.GangBuilderWindowGridRowSelectedBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Setter Property="Foreground" Value="{Binding DataContext.Appearance.GangBuilderWindowButtonTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{Binding DataContext.Appearance.GangBuilderWindowTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>

        <Style TargetType="{x:Type Label}">
            <Setter Property="Foreground" Value="{Binding DataContext.Appearance.GangBuilderWindowTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{Binding DataContext.Appearance.GangBuilderWindowTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>

        <Style TargetType="{x:Type GroupBox}">
            <Setter Property="Foreground" Value="{Binding DataContext.Appearance.GangBuilderWindowTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Padding="14"
            Background="{Binding Appearance.GangBuilderWindowControlBackgroundBrush}"
            BorderBrush="{Binding Appearance.GangBuilderWindowControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="22"
                        Text="Gang Builder" />
                    <TextBlock
                        Margin="0,0,0,14"
                        Opacity="0.8"
                        Text="{Binding RootFolderPath}"
                        TextWrapping="Wrap" />
                    <Popup
                        x:Name="ValidationHintPopup"
                        AllowsTransparency="True"
                        HorizontalOffset="0"
                        IsOpen="False"
                        Placement="Bottom"
                        StaysOpen="True"
                        VerticalOffset="6">
                        <Border
                            Padding="10"
                            Background="#B00020"
                            CornerRadius="6">
                            <DockPanel LastChildFill="True">
                                <Button
                                    x:Name="ValidationHintCloseButton"
                                    Width="22"
                                    Height="22"
                                    Margin="8,0,0,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Click="ValidationHintCloseButton_Click"
                                    Content="✕"
                                    DockPanel.Dock="Right" />
                                <TextBlock
                                    x:Name="ValidationHintPopupTextBlock"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>
                    </Popup>
                    <TabControl Margin="0,0,0,12" SelectedIndex="{Binding IsEditExistingGang, Converter={StaticResource BoolToTabIndex}}">
                        <TabItem Header="Build a gang">
                            <StackPanel>
                                <TextBlock Text="Pack name" />
                                <TextBox Margin="0,6,0,12" Text="{Binding PackName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="New gang ID" />
                                <DockPanel Margin="0,6,0,12">
                                    <Button
                                        Width="110"
                                        Margin="0,0,8,0"
                                        Command="{Binding SuggestNewGangIdCommand}"
                                        Content="Suggest" />
                                    <TextBox x:Name="NewGangIdTextBox" Text="{Binding NewGangId, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>

                                <TextBlock Text="Gang full name" />
                                <TextBox Margin="0,6,0,12" Text="{Binding NewGangFullName, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Clone from gang (required for build)" />
                                <DockPanel Margin="0,6,0,18">
                                    <ComboBox
                                        MinWidth="420"
                                        DisplayMemberPath="DisplayText"
                                        IsEditable="False"
                                        IsSynchronizedWithCurrentItem="False"
                                        IsTextSearchEnabled="True"
                                        ItemsSource="{Binding ExistingGangs}"
                                        SelectedItem="{Binding SelectedCloneGang}" />
                                </DockPanel>
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="Edit a gang">
                            <StackPanel>
                                <TextBlock Text="Gang to edit" />
                                <DockPanel Margin="0,6,0,12">
                                    <ComboBox
                                        MinWidth="420"
                                        DisplayMemberPath="DisplayText"
                                        IsEditable="False"
                                        IsSynchronizedWithCurrentItem="False"
                                        IsTextSearchEnabled="True"
                                        ItemsSource="{Binding ExistingGangs}"
                                        SelectedItem="{Binding SelectedEditGang}" />
                                </DockPanel>
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Text="{Binding EditModeResolvedSourcesWarning}"
                                    TextWrapping="Wrap" />
                                <TextBlock Text="{Binding NewGangId, StringFormat=Gang ID: {0}}" />
                                <TextBlock Margin="0,12,0,0" Text="Gang full name" />
                                <TextBox Margin="0,6,0,0" Text="{Binding NewGangFullName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="16"
                        Text="What should be included?" />
                    <WrapPanel>
                        <CheckBox
                            Margin="0,0,16,10"
                            Content="Zones"
                            IsChecked="{Binding IncludeZones}" />
                        <CheckBox
                            Margin="0,0,16,10"
                            Content="Territories"
                            IsChecked="{Binding IncludeTerritories}" />
                        <CheckBox
                            Margin="0,0,16,10"
                            Content="Territory menus"
                            IsChecked="{Binding IncludeTerritoryMenus}" />
                        <CheckBox
                            Margin="0,0,16,10"
                            Content="People"
                            IsChecked="{Binding IncludePeople}" />
                        <CheckBox
                            Margin="0,0,16,10"
                            Content="Vehicles"
                            IsChecked="{Binding IncludeVehicles}" />
                        <CheckBox
                            Margin="0,0,16,10"
                            Content="Dens"
                            IsChecked="{Binding IncludeDens}" />
                        <CheckBox
                            Margin="0,0,16,10"
                            Content="Dealer menus"
                            IsChecked="{Binding IncludeDealerMenus}" />
                        <CheckBox
                            Margin="0,0,16,10"
                            Content="Weapons"
                            IsChecked="{Binding IncludeWeapons}" />
                        <CheckBox
                            Margin="0,0,16,10"
                            Content="Relationships"
                            IsChecked="{Binding IncludeRelationships}" />
                    </WrapPanel>
                    <StackPanel Visibility="{Binding IncludePeople, Converter={StaticResource BoolToVis}}">
                        <TextBlock
                            Margin="0,10,0,6"
                            FontSize="16"
                            Text="People options" />
                        <CheckBox
                            Margin="0,0,0,6"
                            Content="Use source gang people group"
                            IsChecked="{Binding UseSourceGangPeopleGroup}"
                            IsEnabled="{Binding IncludePeople}"
                            Visibility="{Binding IsEditExistingGang, Converter={StaticResource InverseBoolToVis}}" />
                        <DockPanel Margin="0,0,0,8" LastChildFill="True">
                            <Button
                                Width="80"
                                Margin="8,0,0,0"
                                Command="{Binding RefreshDispatchablePeopleGroupsCommand}"
                                Content="Refresh"
                                DockPanel.Dock="Right"
                                IsEnabled="{Binding IncludePeople}" />
                            <ComboBox
                                x:Name="DispatchablePeopleGroupComboBox"
                                DisplayMemberPath="DisplayText"
                                ItemsSource="{Binding DispatchablePeopleGroups}"
                                SelectedItem="{Binding SelectedDispatchablePeopleGroup}">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="IsEnabled" Value="{Binding IncludePeople}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UseSourceGangPeopleGroup}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                        </DockPanel>
                        <Border Margin="0,6,0,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditExistingGang}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,4"
                                    Opacity="0.85"
                                    Text="Current peds in selected PeopleGroupID" />
                                <ListBox
                                    Height="120"
                                    DisplayMemberPath="DebugName"
                                    ItemsSource="{Binding DispatchablePeopleEntries}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Margin="0,0,0,8"
                            Padding="8"
                            Background="{Binding Appearance.GangBuilderWindowControlBackgroundBrush}"
                            BorderBrush="{Binding Appearance.GangBuilderWindowControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IncludePeople}" Value="True" />
                                                <Condition Binding="{Binding UseSourceGangPeopleGroup}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,6"
                                    FontSize="14"
                                    Text="DispatchablePeople group editor" />
                                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                    <Button
                                        Width="90"
                                        Margin="0,0,8,0"
                                        Command="{Binding AddDispatchablePersonEntryCommand}"
                                        Content="Add ped" />
                                    <Button
                                        Width="90"
                                        Margin="0,0,8,0"
                                        Command="{Binding DuplicateSelectedDispatchablePersonEntryCommand}"
                                        Content="Duplicate" />
                                    <Button
                                        Width="90"
                                        Margin="0,0,8,0"
                                        Command="{Binding RemoveSelectedDispatchablePersonEntryCommand}"
                                        Content="Remove" />
                                    <Button
                                        Width="110"
                                        Command="{Binding ResetDispatchablePeopleEntriesCommand}"
                                        Content="Reset list" />
                                </StackPanel>
                                <DataGrid
                                    MinHeight="160"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    HeadersVisibility="Column"
                                    ItemsSource="{Binding DispatchablePeopleEntries}"
                                    SelectedItem="{Binding SelectedDispatchablePersonEntry}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="*"
                                            Binding="{Binding DebugName, UpdateSourceTrigger=PropertyChanged}"
                                            Header="DebugName" />
                                        <DataGridTextColumn
                                            Width="*"
                                            Binding="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}"
                                            Header="ModelName" />
                                        <DataGridCheckBoxColumn
                                            Width="140"
                                            Binding="{Binding AlwaysHasLongGun, UpdateSourceTrigger=PropertyChanged}"
                                            Header="AlwaysHasLongGun" />
                                        <DataGridTextColumn
                                            Width="90"
                                            Binding="{Binding MinWantedLevelSpawn, UpdateSourceTrigger=PropertyChanged}"
                                            Header="MinWanted" />
                                        <DataGridTextColumn
                                            Width="90"
                                            Binding="{Binding MaxWantedLevelSpawn, UpdateSourceTrigger=PropertyChanged}"
                                            Header="MaxWanted" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock
                                    Margin="0,10,0,6"
                                    FontSize="14"
                                    Text="All fields (advanced)" />
                                <TextBlock Margin="0,0,0,4" Text="Search field names" />
                                <TextBox Margin="0,0,0,8" Text="{Binding DispatchablePersonFieldSearchText, UpdateSourceTrigger=PropertyChanged}" />

                                <DataGrid
                                    MinHeight="160"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    HeadersVisibility="Column"
                                    ItemsSource="{Binding DispatchablePersonFieldsView}"
                                    SelectedItem="{Binding SelectedDispatchablePersonField}">
                                    <DataGrid.Resources>
                                        <DataTemplate x:Key="DefaultDispatchableFieldViewerTemplate">
                                            <TextBlock Text="{Binding Value}" />
                                        </DataTemplate>
                                        <DataTemplate x:Key="DefaultDispatchableFieldEditorTemplate">
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                        <DataTemplate x:Key="BooleanDispatchableFieldEditorTemplate">
                                            <ComboBox SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                                <ComboBoxItem Content="false" Tag="false" />
                                                <ComboBoxItem Content="true" Tag="true" />
                                            </ComboBox>
                                        </DataTemplate>
                                        <DataTemplate x:Key="CombatAbilityDispatchableFieldEditorTemplate">
                                            <ComboBox SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                                <ComboBoxItem Content="0 - Poor" Tag="0" />
                                                <ComboBoxItem Content="1 - Average" Tag="1" />
                                                <ComboBoxItem Content="2 - Professional" Tag="2" />
                                            </ComboBox>
                                        </DataTemplate>

                                        <DataTemplate x:Key="CombatMovementDispatchableFieldEditorTemplate">
                                            <ComboBox SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                                <ComboBoxItem Content="-1 - Default (LSR does not force a value)" Tag="-1" />
                                                <ComboBoxItem Content="0 - Stationary (stand in place)" Tag="0" />
                                                <ComboBoxItem Content="1 - Defensive (uses cover, may blind fire)" Tag="1" />
                                                <ComboBoxItem Content="2 - Offensive (pushes enemy, still uses cover)" Tag="2" />
                                                <ComboBoxItem Content="3 - Suicidal Offensive (aggressive flanks)" Tag="3" />
                                            </ComboBox>
                                        </DataTemplate>

                                        <DataTemplate x:Key="CombatRangeDispatchableFieldEditorTemplate">
                                            <ComboBox SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                                <ComboBoxItem Content="-1 - Default (LSR does not force a value)" Tag="-1" />
                                                <ComboBoxItem Content="0 - Near" Tag="0" />
                                                <ComboBoxItem Content="1 - Medium" Tag="1" />
                                                <ComboBoxItem Content="2 - Far" Tag="2" />
                                                <ComboBoxItem Content="3 - Very Far" Tag="3" />
                                            </ComboBox>
                                        </DataTemplate>
