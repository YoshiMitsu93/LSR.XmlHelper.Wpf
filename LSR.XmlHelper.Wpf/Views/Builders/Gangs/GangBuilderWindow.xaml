                            <TextBox
                                x:Name="NewDenNameTextBox"
                                Margin="0,0,0,8"
                                Text="{Binding NewDenName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,0,0,4" Text="Gang territory color" />
                            <ComboBox
                                Margin="0,0,0,8"
                                IsEditable="False"
                                IsTextSearchEnabled="True"
                                ItemsSource="{Binding GangColorNames}"
                                SelectedItem="{Binding GangColorString, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,0,0,4" Text="Entrance position (X, Y, Z)" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox
                                    Width="110"
                                    Margin="0,0,8,8"
                                    Text="{Binding NewDenX, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox
                                    Width="110"
                                    Margin="0,0,8,8"
                                    Text="{Binding NewDenY, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox
                                    Width="110"
                                    Margin="0,0,0,8"
                                    Text="{Binding NewDenZ, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Button
                                Width="170"
                                Margin="0,0,0,8"
