                                        Width="220"
                                        Margin="0,0,12,0"
                                        Text="{Binding DenInventorySearchText, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Text="Category:" />
                                    <ComboBox
                                        Width="140"
                                        Margin="0,0,12,0"
                                        ItemsSource="{Binding DenInventoryCategories}"
