<Window x:Class="LSR.XmlHelper.Wpf.Views.Dialogs.EditModeBackupPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gang Builder"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="This will edit the following XML files:"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <ListBox Grid.Row="1"
                 x:Name="FilesList"
                 Width="520"
                 Height="160"
                 Margin="0,0,0,12" />

        <TextBlock Grid.Row="2"
                   Text="It is recommended to create backups first."
                   TextWrapping="Wrap"
                   Width="520"
                   Margin="0,0,0,16" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="170" Height="30" Margin="0,0,10,0" Click="Backup_Click">Backup</Button>
            <Button Width="210" Height="30" Margin="0,0,10,0" Click="ProceedWithoutBackup_Click">Proceed without backup</Button>
            <Button Width="110" Height="30" Click="Cancel_Click">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>
