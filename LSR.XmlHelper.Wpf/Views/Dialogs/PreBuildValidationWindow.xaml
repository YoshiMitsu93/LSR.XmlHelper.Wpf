<Window
    x:Class="LSR.XmlHelper.Wpf.Views.Dialogs.PreBuildValidationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Fix these before building"
    Width="760"
    Height="460"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            FontSize="16"
            FontWeight="SemiBold"
            Text="Fix these before building" />

        <ScrollViewer
            Grid.Row="1"
            Margin="0,10,0,10"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,0,0,8">
                            <Button
                                Width="70"
                                Margin="10,0,0,0"
                                Click="GoButton_Click"
                                Content="Go"
                                DockPanel.Dock="Right"
                                Tag="{Binding}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{Binding Message}"
                                TextWrapping="Wrap" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button
            Grid.Row="2"
            Width="110"
            HorizontalAlignment="Right"
            Content="Close"
            IsCancel="True" />
    </Grid>
</Window>
