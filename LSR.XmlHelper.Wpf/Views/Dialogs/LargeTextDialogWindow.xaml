<Window x:Class="LSR.XmlHelper.Wpf.Views.Dialogs.LargeTextDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Details"
        Width="900"
        Height="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding HeaderText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />

        <TextBox Grid.Row="1"
                 Margin="0,10,0,10"
                 Text="{Binding BodyText, Mode=OneWay}"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="120" Height="32" Margin="0,0,8,0" Content="Copy" Click="Copy_Click" />
            <Button Width="120" Height="32" Content="Close" IsDefault="True" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
